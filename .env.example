# Server
PORT=5000
NODE_ENV=development
# Public base URL, used to build links for locally stored photos
BASE_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/townrate

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Firebase (optional - without these, photos are stored on local disk
# and POST /api/auth/firebase returns 503)
# Option A: paste service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; \n sequences are converted to newlines automatically
FIREBASE_PRIVATE_KEY=""
# Option B: path to a service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Uploads
MAX_FILE_SIZE_MB=5
MAX_PHOTOS_PER_BUSINESS=10
