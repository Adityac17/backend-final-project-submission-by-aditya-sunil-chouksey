{
  "name": "townrate-api",
  "version": "1.0.0",
  "description": "TownRate - Local Business Review Platform backend (Node.js, Express, MongoDB, Firebase)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
